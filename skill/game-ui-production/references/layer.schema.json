{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!.*--)[a-zA-Z0-9_-]+$"
    },
    "z": {
      "type": "integer"
    },
    "parent": {
      "type": "string",
      "pattern": "^(?!.*--)[a-zA-Z0-9_-]+$"
    },
    "visible": {
      "type": "boolean"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clip": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "anchor": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "crop": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "body": {
      "type": "boolean"
    },
    "alpha_threshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 254
    },
    "resize": {
      "enum": [
        "native",
        "contain",
        "cover",
        "stretch",
        "grid"
      ]
    },
    "grid": {
      "type": "object",
      "properties": {
        "source_x": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2
        },
        "source_y": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2
        },
        "target_x": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2
        },
        "target_y": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2
        }
      },
      "required": [
        "source_x",
        "source_y",
        "target_x",
        "target_y"
      ],
      "additionalProperties": false
    },
    "mask_ellipse": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "text": {
      "type": "string"
    },
    "font": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "color": {
      "type": "string",
      "minLength": 1
    },
    "xy": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "text_anchor": {
      "type": "string",
      "minLength": 1
    },
    "stroke": {
      "type": "integer",
      "minimum": 0
    },
    "stroke_color": {
      "type": "string",
      "minLength": 1
    },
    "spacing": {
      "type": "integer",
      "minimum": 0
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "max_width": {
      "type": "integer",
      "minimum": 1
    },
    "max_lines": {
      "type": "integer",
      "minimum": 1
    },
    "overflow": {
      "enum": [
        "wrap",
        "ellipsis",
        "clip"
      ]
    },
    "letter_spacing": {
      "type": "number"
    },
    "shadow": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "color": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "offset",
        "color"
      ],
      "additionalProperties": false
    },
    "typography_token": {
      "type": "string",
      "minLength": 1
    },
    "fill_binding": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "z"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "asset",
        "rect",
        "resize"
      ],
      "not": {
        "required": [
          "text"
        ]
      }
    },
    {
      "required": [
        "text",
        "xy"
      ],
      "not": {
        "required": [
          "asset"
        ]
      },
      "anyOf": [
        {
          "required": [
            "font",
            "size",
            "color"
          ]
        },
        {
          "required": [
            "typography_token"
          ]
        }
      ]
    }
  ],
  "allOf": [
    {
      "not": {
        "required": [
          "crop",
          "body"
        ]
      }
    },
    {
      "if": {
        "required": [
          "resize"
        ],
        "properties": {
          "resize": {
            "const": "grid"
          }
        }
      },
      "then": {
        "required": [
          "grid"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}